
.picker-panel {
  left: 50%;
  top: 50%;
  alignment-x: center;
  alignment-y: center;
  width: 404;
  height: 86%;
  padding: 12;
  space-between-entries: 6;
  background-color: rgba(16, 16, 20, 0.92);
  border-radius: 8;
}

.picker-header {
  width: 100%;
  height: fit-content;
  space-between-entries: 6;
}

.picker-title-row {
  width: 100%;
  height: 16;
  orientation: horizontal;
  space-between-entries: 6;
}

.picker-logo {
  width: 16;
  height: 16;
  top: 50%;
  alignment-y: center;
}

.picker-title {
  font-size: 1.3;
  text-color: white;
  top: 50%;
  alignment-y: center;
}

.picker-count {
  font-size: 0.8;
  text-color: gray;
  top: 50%;
  alignment-y: center;
}

.picker-close {
  width: 16;
  height: 16;
  font-size: 0.9;
  padding: 0;
}

.picker-search {
  width: 100%;
  height: 20;
}

.picker-tabs {
  width: 100%;
  height: 14;
  space-between-entries: 4;
}

.picker-tab {
  width: fit-content;
  height: 14;
  padding-left: 8;
  padding-right: 8;
  padding-top: 3;
  font-size: 0.8;
  text-color: rgba(255, 255, 255, 0.55);
  background-color: rgba(255, 255, 255, 0.06);
  border-radius: 4;
  background-color-transition-duration: 120;

  &:hover {
    text-color: white;
    background-color: rgba(255, 255, 255, 0.14);
  }
}

.picker-tab-active {
  width: fit-content;
  height: 14;
  padding-left: 8;
  padding-right: 8;
  padding-top: 3;
  font-size: 0.8;
  text-color: white;
  background-color: rgba(255, 255, 255, 0.22);
  border-radius: 4;
}

.picker-divider {
  width: 100%;
  height: 1;
  background-color: rgba(255, 255, 255, 0.10);
}

.picker-scroll {
  width: 100%;
  height: 100%;

  .picker-body {
    width: 100%;
    height: fit-content;
    space-between-entries: 6;
    padding-right: 6;
  }

  Scrollbar {
    width: 3;
  }
}

.picker-section {
  font-size: 0.8;
  text-color: rgba(255, 255, 255, 0.55);
  margin-top: 2;
}

.picker-grid {
  width: 100%;
  height: fit-content;
  space-between-entries: 3;
}

/* Tiles are 28 + 2*2 padding = 32 wide; 10 * 32 + 9 * 4 = 356 fits the 374 wide body. */
.picker-row {
  width: 100%;
  height: 32;
  space-between-entries: 4;
}

.picker-emote {
  width: 28;
  height: 28;
  padding: 2;
  background-color: rgba(255, 255, 255, 0.07);
  border-radius: 4;
  background-color-transition-duration: 120;

  &:hover {
    background-color: rgba(255, 255, 255, 0.18);
  }

  &:active {
    background-color: rgba(255, 255, 255, 0.30);
  }
}

.picker-more {
  width: 180;
  height: 18;
  left: 50%;
  alignment-x: center;
  margin-top: 6;
  margin-bottom: 6;
  font-size: 0.85;
}

.picker-empty {
  width: 100%;
  text-color: gray;
  alignment-x: center;
  margin-top: 24;
}

.picker-hint {
  width: 100%;
  font-size: 0.75;
  text-color: rgba(255, 255, 255, 0.4);
  alignment-x: center;
}

.picker-credit {
  width: 100%;
  font-size: 0.65;
  text-color: rgba(255, 255, 255, 0.25);
  alignment-x: center;
}
